---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;
---

<Layout title="길을 잃으셨나요? | 인터넷 미아 안내소" description="페이지를 찾을 수 없어요. 인터넷 미아 안내소의 첫 화면으로 돌아가세요." robots="noindex, nofollow">
  <div class="page-shell error-page">
    <p class="kicker">404 · 목적지가 없어요</p>
    <h1>여기도 아닌가 봐요.</h1>
    <p>찾으려던 페이지가 보이지 않네요. 안내소 첫 화면으로 돌아가 볼까요?</p>
    <a class="button button-primary" href={base}>안내소 첫 화면으로 돌아가기</a>
  </div>
</Layout>
